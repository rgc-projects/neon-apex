{
  "name": "neon-apex",
  "version": "2.1.3",
  "description": "NEON APEX — 3D Cyber Arcade Racing Game built with Three.js, WebGL Bloom, Web Audio Synthwave Engine, and Cloudflare Workers Static Assets",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 5173",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173",
    "cf:dev": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "deploy:dry": "npm run build && wrangler deploy --dry-run",
    "android:sync": "npm run build && cap sync android",
    "android:open": "cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^7.6.11",
    "@capacitor/app": "^7.1.2",
    "@capacitor/core": "^7.6.11",
    "@capacitor/haptics": "^7.0.5",
    "@capacitor/screen-orientation": "^7.0.4",
    "@capacitor/status-bar": "^7.0.6",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.6.11",
    "@types/three": "^0.170.0",
    "typescript": "^5.6.3",
    "vite": "^6.0.3",
    "wrangler": "^4.0.0"
  },
  "license": "MIT"
}
